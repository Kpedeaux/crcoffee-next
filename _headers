# Production headers for crcoffeenola.com (installed as _headers by the launch commit).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google.com https://googleads.g.doubleclick.net https://www.googleadservices.com; media-src 'self'; connect-src 'self' https://forms.creativecorerail.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://googleads.g.doubleclick.net; frame-src https://www.google.com https://maps.google.com https://www.youtube-nocookie.com https://td.doubleclick.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://forms.creativecorerail.com https://squareup.com

/sitemap.xml
  Content-Type: application/xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/manifest.json
  Content-Type: application/manifest+json

/.well-known/ai-agent.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Long-lived caching: css and js are safe at a year because every reference
# carries a ?v= cache-buster. Fonts never change in place. Images and video
# get swapped in place for seasonal changes, so they get a week.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/font/*
  Cache-Control: public, max-age=31536000, immutable

/video/*
  Cache-Control: public, max-age=604800

/img/*
  Cache-Control: public, max-age=604800
